# Native Nuxt runtime overrides (safe to supply to an already-built Docker image).
# See docs/production.md. Never put secrets in NUXT_PUBLIC_* variables.

# CDN Configuration
NUXT_PUBLIC_CDN_URL=https://cdn.topiqu.com

# Cloudflare Turnstile (for onboarding form protection)
NUXT_TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADTMd0bwWSANE2RG

# Token signing secret (shared with platform for verified-token validation)
NUXT_AUTH_SECRET=

# Main Topiqu platform — receives checkout data from this landing (server-side)
NUXT_PLATFORM_API_URL=https://app.topiqu.com

# Public URL of the platform — existing-client login redirect target (client-side)
NUXT_PUBLIC_PLATFORM_URL=https://app.topiqu.com

# Better Stack status page — header status pill reads its public aggregate_state
NUXT_PUBLIC_STATUS_URL=https://status.topiqu.com

# Email (AWS SES v2) — domain topiqu.com must be a verified identity in this region.
# NOTE: SES_-prefixed (not AWS_*) because AWS_REGION/AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY are reserved & overwritten by the Vercel/Lambda runtime.
SES_REGION=eu-central-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
NUXT_EMAIL_FROM=Topiqu <noreply@topiqu.com>

# Google Analytics (nuxt-gtag) — format: G-XXXXXXXXXX
NUXT_PUBLIC_GTAG_ID=
